# Copy to secrets/carplay.env (gitignored) and fill in.
CAR_SSID='BMW12345 CarPlay'
CAR_PSK='...'

# Deploy targets for scripts/deploy-carplayd-sbc.sh. The script's own defaults
# are scrubbed placeholders (this repo is public) and it refuses to run with
# them, so set the real ones here -- this file is gitignored.
#SBC=user@your-garage-box
#BUILD=user@your-build-host

# Egress cap per car link (carplayd `rate`); "off" disables shaping. See
# docs/test-log.md 2026-11-16: uncapped, saturating the box made the head unit
# drop CarPlay and need a hard reset.
#CAR_RATE=2mbit
