#!/bin/sh /etc/rc.common
# carplayd on OpenWrt (procd). The radio used by carplayd must be disabled in
# /etc/config/wireless so netifd leaves it alone; fw4 provides the zone and
# NAT66 (masq6) for the STA device.

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/carplayd -c /etc/carplayd.conf
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}
