# carplayd configuration (keep it 0600: it holds the cars' Wi-Fi passwords).

# The radio and the STA netdev carplayd uses. On OpenWrt carplayd creates the
# STA on a radio netifd doesn't manage; on Debian point it at wlan0 and tell
# NetworkManager to leave wlan0 alone.
phy = phy0
sta = phy0-sta0

# The interface toward the internet. Needed for NAT66 and for the firewall to
# know the home LAN (its on-link prefixes, widened to /56, are blocked).
#uplink = eth0

# NAT66: "none" when fw4 masq6 does it (OpenWrt), "nft" (or "ip6tables") on Debian.
nat66 = none

# Isolation (default nft): a phone on the car Wi-Fi reaches the internet only.
# carplayd's own nftables table drops everything from the car link to the box
# except ICMPv6 (ND, RS) and rejects forwarding to ULA, link-local, the home
# LAN, the other car, and anything not leaving via the uplink.
#firewall = nft
# more destinations phones must not reach (other home networks)
#block = 2001:db8:100::/48

# DNS servers advertised to phones (RDNSS).
dns = 2001:4860:4860::8888, 2606:4700:4700::1111

# Upstream health: while none of the targets accepts a TCP connection (2 s
# timeout; health_fail checks in a row), carplayd withdraws the route (router,
# RDNSS and preferred lifetimes 0) but stays on the car, so the phone falls
# back to cellular and gets the route back as soon as a check passes.
#health = on
#health_interval = 3s
#health_fail = 2
# default: each dns server, port 53
#health_target = [2001:4860:4860::8888]:53

# Timing. Defaults shown.
# hunt: scan period while no car is served
#hunt = 1s
# poll: signal poll period while serving
#poll = 1s
# leave_for: below the leave threshold this long, then goodbye + leave
#leave_for = 3s
# ra_interval: MaxRtrAdvInterval (RFC 4861, at least 4s). Periodic multicast
# RAs go out every random 3-4 s, never closer than 3 s; a Router Solicitation
# (or a new device's first MLD report) is answered by unicast after 0-0.5 s.
#ra_interval = 4s
# router_lifetime: an abrupt drive-out strands a phone at most this long
#router_lifetime = 20s
# idle_switch: serve another car once the served one has had no phone this long
#idle_switch = 1m

# Lab: event log and Prometheus metrics.
#events = /var/log/carplayd.events
# survey: also log each visible car's signal this often (sighting while
# hunting, signal while serving) and "gone" when it disappears; 0 = off
#survey = 10s
#metrics = 127.0.0.1:9101
# debug: for a drive assessment. Every event line already carries the wall
# clock, and every wpa_supplicant control event is logged either way; this adds
# the per-tick detail — the full scan (not just the configured cars), the raw
# station dump, the neighbour table, and the leave decision with its
# thresholds and trend baseline. Roughly 4 MB/hour while serving.
#debug = off

[car A]
ssid = BMW00001 CarPlay
# From the iPhone: Settings > Wi-Fi > Edit > Known Networks > the car > Password
psk = CHANGE-ME-PSK
# channel 0 = unknown: hunt on all of 2.4 GHz and log where the car is seen
channel = 11
#bssid = bc:30:7e:xx:xx:xx
priority = 1
# default prefix: fd5c:ba1e:f32:a::/64 for the first car, :b:: for the second, ...
#prefix = fd5c:ba1e:f32:a::/64
#join = -80
#leave = -84
#rejoin = -76

[car B]
ssid = BMW00002 CarPlay
psk = CHANGE-ME-PSK
channel = 0
